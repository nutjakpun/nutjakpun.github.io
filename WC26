    <script>
        // Configure URL of config.json (Change your IP or Domain here)
        const CONFIG_URL = 'https://tv.laoid.net/world-cup/config.json';

        let CHANNELS_DATA = [];
        let selectedChannelIndex = 0;
        let selectedProtocol = 'DASH';

        let DEFAULT_CHANNEL = {
            name: 'LaoTV Football',
            url: 'https://ctrl.laotv.la/tokenlive/LaoTV_Football/manifest.mpd?va=1781251897&token=77f316ec03903fdfbc58',
            SigmaDrmMerchantId: 'unitel',
            SigmaDrmUserId: 'a8757e1071104551a7b561b04869cd3c',
            SigmaDrmJwt: ''
        };
        let currentChannel = null;

        const video = document.getElementById('liveVideo');
        const playerSection = document.getElementById('playerSection');
        const loadingSpinner = document.getElementById('loadingSpinner');
        const playPauseBtn = document.getElementById('playPauseBtn');
        const playIcon = document.getElementById('playIcon');
        const muteBtn = document.getElementById('muteBtn');
        const volumeIcon = document.getElementById('volumeIcon');
        const volumeSlider = document.getElementById('volumeSlider');
        const progressSlider = document.getElementById('progressSlider');
        const fullscreenBtn = document.getElementById('fullscreenBtn');
        const fullscreenIcon = document.getElementById('fullscreenIcon');
        const pipBtn = document.getElementById('pipBtn');
        const syncLiveBtn = document.getElementById('syncLiveBtn');

        const playerTitle = document.getElementById('playerTitle');
        const staticContent = document.getElementById('staticContent');
        const controlLayer = document.getElementById('controlLayer');

        const settingsBtn = document.getElementById('settingsBtn');

        // Only show reload button on mobile devices
        const isMobileDevice = /android|mobi|ipad|iphone|ipod|silk|gt-p1000|nexus 7|kindle fire|opera mini/i.test(navigator.userAgent.toLowerCase());
        if (isMobileDevice) {
            document.documentElement.classList.add('mobile-device');
            const reloadBtn = document.getElementById('reloadBtn');
            if (reloadBtn) {
                reloadBtn.style.display = 'flex';
            }
            if (isIOSDevice()) {
                document.documentElement.classList.add('ios-device');
            }
        }

        let hls = null;
        let dashPlayer = null;
        let loadedStreamUrl = '';
        let lastAudibleVolume = 1;
        let volumeFadeTimer = null;

        function applyChannel(ch) {
            currentChannel = ch;
            localStorage.setItem('laotv_live_single_channel', JSON.stringify(ch));
            playerTitle.textContent = ch.name;
            staticContent.style.display = 'none';
            playStream(ch.url);

            // Update active state of selector buttons
            document.querySelectorAll('.stream-select-btn').forEach(btn => {
                if (btn.dataset.url === ch.url) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        // Stream Player Engine (HLS, DASH & Direct MP4)
        function playStream(url) {
            loadedStreamUrl = url;
            loadingSpinner.style.display = 'flex';
            if (hls) {
                hls.destroy();
                hls = null;
            }
            if (dashPlayer) {
                dashPlayer.destroy();
                dashPlayer = null;
            }

            const attemptPlay = () => {
                video.play().catch((err) => {
                    loadingSpinner.style.display = 'none';
                    staticContent.style.display = 'flex';
                    console.log("Playback was blocked.", err);
                });
            };

            if (url.toLowerCase().includes('.m3u8')) {
                if (Hls.isSupported()) {
                    hls = new Hls();
                    hls.loadSource(url);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.MANIFEST_PARSED, () => {
                        attemptPlay();
                        updateAudioTrackVisibility();
                    });
                    hls.on(Hls.Events.AUDIO_TRACKS_UPDATED, () => {
                        updateAudioTrackVisibility();
                    });
                    hls.on(Hls.Events.AUDIO_TRACK_SWITCHED, () => {
                        updateAudioTrackVisibility();
                    });
                } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                    video.src = url;
                    video.addEventListener('loadedmetadata', () => {
                        attemptPlay();
                        updateAudioTrackVisibility();
                        if (video.audioTracks) {
                            video.audioTracks.addEventListener('change', updateAudioTrackVisibility);
                        }
                    }, { once: true });
                }
            } else if (url.toLowerCase().includes('.mpd')) {
                dashPlayer = dashjs.MediaPlayer().create();

                // Configure SigmaDRM protection if metadata is present
                if (currentChannel.SigmaDrmMerchantId || currentChannel.SigmaDrmUserId) {
                    const payload = {
                        userId: currentChannel.SigmaDrmUserId || "",
                        merchantId: currentChannel.SigmaDrmMerchantId || "",
                        sessionId: currentChannel.SigmaDrmJwt || ""
                    };
                    const customData = btoa(JSON.stringify(payload));

                    dashPlayer.setProtectionData({
                        "com.widevine.alpha": {
                            "serverURL": "https://drm.laotv.la/widevine",
                            "httpRequestHeaders": {
                                "custom-data": customData
                            }
                        }
                    });
                }

                dashPlayer.initialize(video, url, true);
                dashPlayer.on(dashjs.MediaPlayer.events.CAN_PLAY, () => {
                    attemptPlay();
                    updateAudioTrackVisibility();
                });
                dashPlayer.on(dashjs.MediaPlayer.events.TRACK_CHANGE_RENDERED, () => {
                    updateAudioTrackVisibility();
                });
            } else {
                video.src = url;
                video.addEventListener('loadedmetadata', () => {
                    attemptPlay();
                    updateAudioTrackVisibility();
                    if (video.audioTracks) {
                        video.audioTracks.addEventListener('change', updateAudioTrackVisibility);
                    }
                }, { once: true });
            }
        }

        // Play/Pause Action
        function togglePlay() {
            if (video.paused) {
                if (!loadedStreamUrl || (currentChannel && loadedStreamUrl !== currentChannel.url)) {
                    selectChannel(selectedChannelIndex, true);
                    return;
                }
                video.play();
            } else {
                video.pause();
            }
        }

        video.addEventListener('play', () => {
            playIcon.textContent = 'pause';
        });

        video.addEventListener('pause', () => {
            playIcon.textContent = 'play_arrow';
        });

        playPauseBtn.onclick = togglePlay;
        const handleStartPlay = (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (CHANNELS_DATA.length > 0) {
                selectChannel(selectedChannelIndex, true);
            } else if (currentChannel) {
                applyChannel(currentChannel);
            }
        };
        staticContent.addEventListener('click', handleStartPlay);
        staticContent.addEventListener('touchstart', handleStartPlay, { passive: false });

        // Spacebar playback control
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && document.activeElement.tagName !== 'INPUT') {
                e.preventDefault();
                togglePlay();
            }
        });

        // Volume controller
        function clampVolume(val) {
            return Math.max(0, Math.min(1, Number(val) || 0));
        }

        function updateVolumeIcon(val) {
            if (video.muted || val === 0) {
                volumeIcon.textContent = 'volume_off';
            } else if (val < 0.5) {
                volumeIcon.textContent = 'volume_down';
            } else {
                volumeIcon.textContent = 'volume_up';
            }
        }

        function updateVolumeUI(val) {
            volumeSlider.value = val;
            setSliderFill(volumeSlider, val, 0, 1);
            updateVolumeIcon(val);
        }

        function setVideoVolume(val) {
            try {
                video.volume = val;
            } catch (e) { }
        }

        function fadeVolumeTo(targetVolume) {
            const finalVolume = clampVolume(targetVolume || lastAudibleVolume || 1);
            clearInterval(volumeFadeTimer);
            video.muted = false;
            setVideoVolume(0);
            updateVolumeUI(0);

            if (video.paused) {
                video.play().catch(err => console.log("Playback failed after unmute:", err));
            }

            let step = 0;
            const totalSteps = 12;
            volumeFadeTimer = setInterval(() => {
                step += 1;
                const nextVolume = (finalVolume * step) / totalSteps;
                setVideoVolume(nextVolume);
                updateVolumeUI(nextVolume);

                if (step >= totalSteps) {
                    clearInterval(volumeFadeTimer);
                    volumeFadeTimer = null;
                    lastAudibleVolume = finalVolume;
                    setVideoVolume(finalVolume);
                    updateVolumeUI(finalVolume);
                }
            }, 80);
        }

        function updateVolume(val, fromUserGesture = false, fadeIn = false) {
            clearInterval(volumeFadeTimer);
            volumeFadeTimer = null;
            const nextVolume = clampVolume(val);
            const isIOS = isIOSDevice();

            if (nextVolume > 0) {
                lastAudibleVolume = nextVolume;
            }

            if (isIOS && fadeIn && fromUserGesture && nextVolume > 0) {
                fadeVolumeTo(nextVolume);
                return;
            }

            setVideoVolume(nextVolume);

            if (nextVolume > 0 && (fromUserGesture || video.muted)) {
                video.muted = false;
                if (video.paused) {
                    video.play().catch(err => console.log("Playback failed after unmute:", err));
                }
            } else if (nextVolume === 0) {
                video.muted = true;
            }

            updateVolumeUI(nextVolume);
        }

        function setSliderFill(slider, val, min, max) {
            const pct = ((val - min) / (max - min)) * 100;
            slider.style.setProperty('--slider-percent', `${pct}%`);
        }

        volumeSlider.oninput = (e) => updateVolume(e.target.value, true);
        muteBtn.onclick = () => {
            const shouldUnmute = video.muted || Number(volumeSlider.value) === 0;
            video.muted = !shouldUnmute;
            if (!shouldUnmute) {
                volumeIcon.textContent = 'volume_off';
                volumeSlider.value = 0;
                setSliderFill(volumeSlider, 0, 0, 1);
            } else {
                updateVolume(video.volume || lastAudibleVolume || 1, true, true);
            }
        };

        video.addEventListener('volumechange', () => {
            if (isIOSDevice() && video.muted && video.volume > 0) {
                fadeVolumeTo(video.volume);
            }
        });

        // Progress Seek Control
        progressSlider.oninput = (e) => {
            const val = e.target.value;
            setSliderFill(progressSlider, val, 0, 100);
            if (video.duration) {
                video.currentTime = (val / 100) * video.duration;
            }
        };

        video.addEventListener('timeupdate', () => {
            if (video.duration) {
                const val = (video.currentTime / video.duration) * 100;
                progressSlider.value = val;
                setSliderFill(progressSlider, val, 0, 100);
            }
        });

        syncLiveBtn.onclick = () => {
            if (video.duration) {
                video.currentTime = video.duration;
            }
        };

        // Fullscreen
        function isIOSDevice() {
            return /iPad|iPhone|iPod/.test(navigator.userAgent) ||
                (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        }

        function enterNativeVideoFullscreen() {
            if (typeof video.webkitEnterFullscreen === 'function') {
                video.webkitEnterFullscreen();
                return true;
            }

            if (typeof video.webkitRequestFullscreen === 'function') {
                video.webkitRequestFullscreen();
                return true;
            }

            return false;
        }

        fullscreenBtn.onclick = async () => {
            try {
                if (document.fullscreenElement) {
                    await document.exitFullscreen();
                    return;
                }

                if (isIOSDevice() && enterNativeVideoFullscreen()) {
                    fullscreenIcon.textContent = 'fullscreen_exit';
                    return;
                }

                if (playerSection.requestFullscreen) {
                    await playerSection.requestFullscreen();
                } else if (video.requestFullscreen) {
                    await video.requestFullscreen();
                } else {
                    enterNativeVideoFullscreen();
                }
            } catch (err) {
                console.error('Fullscreen failed', err);
            }
        };

        document.addEventListener('fullscreenchange', () => {
            if (document.fullscreenElement) {
                fullscreenIcon.textContent = 'fullscreen_exit';
            } else {
                fullscreenIcon.textContent = 'fullscreen';
            }
        });

        video.addEventListener('webkitbeginfullscreen', () => {
            fullscreenIcon.textContent = 'fullscreen_exit';
        });

        video.addEventListener('webkitendfullscreen', () => {
            fullscreenIcon.textContent = 'fullscreen';
        });

        // Picture-in-picture
        pipBtn.onclick = async () => {
            try {
                if (video !== document.pictureInPictureElement) {
                    await video.requestPictureInPicture();
                } else {
                    await document.exitPictureInPicture();
                }
            } catch (err) {
                console.error("Picture-in-picture failed", err);
            }
        };

        // Loading spinner status
        video.addEventListener('waiting', () => loadingSpinner.style.display = 'flex');
        video.addEventListener('playing', () => loadingSpinner.style.display = 'none');
        video.addEventListener('canplay', () => loadingSpinner.style.display = 'none');

        // Settings Panel DOM Elements
        const settingsPanel = document.getElementById('settingsPanel');
        const settingsMainMenu = document.getElementById('settingsMainMenu');
        const settingsRateMenu = document.getElementById('settingsRateMenu');
        const settingsQualityMenu = document.getElementById('settingsQualityMenu');
        const settingsAudioMenu = document.getElementById('settingsAudioMenu');
        const optPlaybackRate = document.getElementById('optPlaybackRate');
        const optQuality = document.getElementById('optQuality');
        const valPlaybackRate = document.getElementById('valPlaybackRate');
        const valQuality = document.getElementById('valQuality');
        const backToMainFromRate = document.getElementById('backToMainFromRate');
        const backToMainFromQuality = document.getElementById('backToMainFromQuality');
        const backToMainFromAudio = document.getElementById('backToMainFromAudio');
        const qualityOptionsList = document.getElementById('qualityOptionsList');
        const audioOptionsList = document.getElementById('audioOptionsList');
        const editChannelBtn = document.getElementById('editChannelBtn');
        const audioBtn = document.getElementById('audioBtn');

        // Modal triggers
        // Toggle Settings Panel
        settingsBtn.onclick = (e) => {
            e.stopPropagation();
            updateAudioTrackVisibility();
            settingsPanel.classList.toggle('show');
            showSettingsMenu('main');
        };

        audioBtn.onclick = (e) => {
            e.stopPropagation();
            updateAudioTrackVisibility();
            populateAudioMenu();
            settingsPanel.classList.add('show');
            showSettingsMenu('audio');
        };

        // Navigation inside Settings panel
        function showSettingsMenu(menu) {
            settingsMainMenu.style.display = menu === 'main' ? 'block' : 'none';
            settingsRateMenu.style.display = menu === 'rate' ? 'block' : 'none';
            settingsQualityMenu.style.display = menu === 'quality' ? 'block' : 'none';
            settingsAudioMenu.style.display = menu === 'audio' ? 'block' : 'none';
        }

        optPlaybackRate.onclick = (e) => {
            e.stopPropagation();
            showSettingsMenu('rate');
        };

        optQuality.onclick = (e) => {
            e.stopPropagation();
            populateQualityMenu();
            showSettingsMenu('quality');
        };

        backToMainFromRate.onclick = (e) => {
            e.stopPropagation();
            showSettingsMenu('main');
        };

        backToMainFromQuality.onclick = (e) => {
            e.stopPropagation();
            showSettingsMenu('main');
        };

        backToMainFromAudio.onclick = (e) => {
            e.stopPropagation();
            showSettingsMenu('main');
        };

        // Playback Rate Selection
        const rateOptions = settingsRateMenu.querySelectorAll('.settings-item-option');
        rateOptions.forEach(opt => {
            opt.onclick = (e) => {
                e.stopPropagation();
                const speed = parseFloat(opt.dataset.value);
                video.playbackRate = speed;

                rateOptions.forEach(o => o.classList.remove('active'));
                opt.classList.add('active');

                valPlaybackRate.innerHTML = `${opt.textContent.split(' ')[0]} <span class="material-icons-round" style="font-size: 16px;">chevron_right</span>`;
                settingsPanel.classList.remove('show');
            };
        });

        // HLS & DASH Quality Level Management
        function populateQualityMenu() {
            qualityOptionsList.innerHTML = '';

            let levels = [];
            let currentLevel = -1;

            if (hls && Hls.isSupported()) {
                levels = hls.levels;
                currentLevel = hls.currentLevel;
            } else if (dashPlayer) {
                levels = dashPlayer.getBitrateInfoListFor("video");
                currentLevel = dashPlayer.getQualityFor("video");
            }

            // Auto Option
            const autoOpt = document.createElement('div');
            autoOpt.className = `settings-item-option ${currentLevel === -1 ? 'active' : ''}`;
            autoOpt.textContent = 'Auto';
            autoOpt.onclick = (e) => {
                e.stopPropagation();
                if (hls) {
                    hls.currentLevel = -1;
                } else if (dashPlayer) {
                    dashPlayer.setAutoSwitchQualityFor("video", true);
                }
                valQuality.innerHTML = `Auto <span class="material-icons-round" style="font-size: 16px;">chevron_right</span>`;
                settingsPanel.classList.remove('show');
            };
            qualityOptionsList.appendChild(autoOpt);

            // Level Options
            levels.forEach((lvl, idx) => {
                let height = '';
                if (hls) {
                    height = lvl.height + 'p';
                } else if (dashPlayer) {
                    height = lvl.height + 'p';
                }

                const opt = document.createElement('div');
                opt.className = `settings-item-option ${currentLevel === idx ? 'active' : ''}`;
                opt.textContent = height;
                opt.onclick = (e) => {
                    e.stopPropagation();
                    if (hls) {
                        hls.currentLevel = idx;
                    } else if (dashPlayer) {
                        dashPlayer.setAutoSwitchQualityFor("video", false);
                        dashPlayer.setQualityFor("video", idx);
                    }
                    valQuality.innerHTML = `${height} <span class="material-icons-round" style="font-size: 16px;">chevron_right</span>`;
                    settingsPanel.classList.remove('show');
                };
                qualityOptionsList.appendChild(opt);
            });

            // Default fallback if no stream engine is active
            if (levels.length === 0) {
                const mockOpt = document.createElement('div');
                mockOpt.className = 'settings-item-option active';
                mockOpt.textContent = 'Original / Auto';
                qualityOptionsList.appendChild(mockOpt);
            }
        }

        function isUndeterminedAudioTrack(label, language) {
            const normalizedLabel = String(label || '').trim().toLowerCase();
            const normalizedLanguage = String(language || '').trim().toLowerCase();
            return normalizedLabel === 'undetermined' || normalizedLanguage === 'und';
        }

        function getHlsSelectableAudioTracks() {
            if (!hls || !Hls.isSupported() || !hls.audioTracks) return [];
            return hls.audioTracks
                .map((track, idx) => ({ track, idx }))
                .filter(({ track }) => !isUndeterminedAudioTrack(track.name, track.lang));
        }

        function updateAudioTrackVisibility() {
            let hasTracks = false;
            let currentTrackLabel = 'Default';

            if (hls && Hls.isSupported() && hls.audioTracks && hls.audioTracks.length > 1) {
                const selectableTracks = getHlsSelectableAudioTracks();
                hasTracks = selectableTracks.length > 1;
                const currentTrackIdx = hls.audioTrack;
                if (currentTrackIdx !== -1 && hls.audioTracks[currentTrackIdx]) {
                    currentTrackLabel = hls.audioTracks[currentTrackIdx].name || hls.audioTracks[currentTrackIdx].lang || `Track ${currentTrackIdx + 1}`;
                }
            } else if (dashPlayer) {
                const tracks = dashPlayer.getTracksFor("audio");
                const selectableTracks = tracks ? tracks.filter(track => !isUndeterminedAudioTrack(track.lang || track.id, track.lang)) : [];
                if (selectableTracks.length > 1) {
                    hasTracks = true;
                    const currentTrack = dashPlayer.getCurrentTrackFor("audio");
                    if (currentTrack) {
                        currentTrackLabel = currentTrack.lang || currentTrack.id || 'Default';
                    }
                }
            } else if (video.audioTracks && video.audioTracks.length > 1) {
                let selectableTrackCount = 0;
                for (let i = 0; i < video.audioTracks.length; i++) {
                    const track = video.audioTracks[i];
                    if (!isUndeterminedAudioTrack(track.label, track.language)) {
                        selectableTrackCount += 1;
                    }

                    if (video.audioTracks[i].enabled) {
                        currentTrackLabel = video.audioTracks[i].label || video.audioTracks[i].language || `Track ${i + 1}`;
                    }
                }
                hasTracks = selectableTrackCount > 1;
            }

            if (hasTracks) {
                audioBtn.style.display = 'inline-flex';
            } else {
                audioBtn.style.display = 'none';
            }
        }

        function populateAudioMenu() {
            audioOptionsList.innerHTML = '';

            if (hls && Hls.isSupported() && hls.audioTracks && hls.audioTracks.length > 1) {
                const tracks = getHlsSelectableAudioTracks();
                const currentTrackIdx = hls.audioTrack;

                tracks.forEach(({ track, idx }) => {
                    const label = track.name || track.lang || `Track ${idx + 1}`;
                    const opt = document.createElement('div');
                    opt.className = `settings-item-option ${currentTrackIdx === idx ? 'active' : ''}`;
                    opt.textContent = label;
                    opt.onclick = (e) => {
                        e.stopPropagation();
                        hls.audioTrack = idx;
                        settingsPanel.classList.remove('show');
                    };
                    audioOptionsList.appendChild(opt);
                });
            } else if (dashPlayer) {
                const tracks = dashPlayer.getTracksFor("audio");
                const currentTrack = dashPlayer.getCurrentTrackFor("audio");

                if (tracks) {
                    tracks
                        .filter(track => !isUndeterminedAudioTrack(track.lang || track.id, track.lang))
                        .forEach((track) => {
                        const label = track.lang || track.id || 'Unknown';
                        const isActive = currentTrack && (currentTrack.id === track.id || currentTrack.lang === track.lang);
                        const opt = document.createElement('div');
                        opt.className = `settings-item-option ${isActive ? 'active' : ''}`;
                        opt.textContent = label;
                        opt.onclick = (e) => {
                            e.stopPropagation();
                            dashPlayer.setCurrentTrack(track);
                            settingsPanel.classList.remove('show');
                        };
                        audioOptionsList.appendChild(opt);
                    });
                }
            } else if (video.audioTracks && video.audioTracks.length > 1) {
                const tracks = video.audioTracks;

                for (let idx = 0; idx < tracks.length; idx++) {
                    const track = tracks[idx];
                    if (isUndeterminedAudioTrack(track.label, track.language)) continue;

                    const label = track.label || track.language || `Track ${idx + 1}`;
                    const opt = document.createElement('div');
                    opt.className = `settings-item-option ${track.enabled ? 'active' : ''}`;
                    opt.textContent = label;
                    opt.onclick = (e) => {
                        e.stopPropagation();
                        for (let i = 0; i < tracks.length; i++) {
                            tracks[i].enabled = (i === idx);
                        }
                        settingsPanel.classList.remove('show');
                    };
                    audioOptionsList.appendChild(opt);
                }
            } else {
                const mockOpt = document.createElement('div');
                mockOpt.className = 'settings-item-option active';
                mockOpt.textContent = 'Default';
                audioOptionsList.appendChild(mockOpt);
            }
        }

        // Hide settings popup on clicking outside
        document.addEventListener('click', () => {
            settingsPanel.classList.remove('show');
        });

        // Auto-Hide Control bar on inactivity
        let controlsTimeout;
        function hideControls() {
            playerSection.classList.add('controls-hidden');
        }
        function resetControls() {
            playerSection.classList.remove('controls-hidden');
            clearTimeout(controlsTimeout);
            if (!video.paused) {
                controlsTimeout = setTimeout(hideControls, 3000);
            }
        }
        playerSection.onmousemove = resetControls;
        const handlePlayerSectionTap = (e) => {
            // If settings panel or control buttons are clicked, just reset the auto-hide timer
            if (e.target.closest('#controlLayer') || e.target.closest('#settingsPanel') || e.target.closest('#settingsBtn') || e.target.closest('#audioBtn')) {
                resetControls();
                return;
            }
            if (playerSection.classList.contains('controls-hidden')) {
                resetControls();
            } else {
                togglePlay();
            }
        };
        playerSection.addEventListener('click', handlePlayerSectionTap);
        playerSection.addEventListener('touchstart', (e) => {
            // Check if clicked inside controls
            if (e.target.closest('#controlLayer') || e.target.closest('#settingsPanel') || e.target.closest('#settingsBtn') || e.target.closest('#audioBtn')) {
                resetControls();
                return;
            }
            e.preventDefault();
            handlePlayerSectionTap(e);
        }, { passive: false });
        video.onplay = resetControls;
        video.onpause = () => {
            playerSection.classList.remove('controls-hidden');
            clearTimeout(controlsTimeout);
        };

        // Stream selection config and dynamic loading
        function selectChannel(channelIndex, shouldPlay = true) {
            selectedChannelIndex = channelIndex;
            const channel = CHANNELS_DATA[channelIndex];
            if (!channel) return;

            // Automatically determine best protocol (HLS for Safari/iOS, DASH otherwise)
            const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent) ||
                /iPad|iPhone|iPod/.test(navigator.userAgent);
            let preferredProtocol = isSafari ? 'HLS' : 'DASH';

            let link = channel.Links.find(l => l.Protocol.toUpperCase() === preferredProtocol);
            if (!link && channel.Links.length > 0) {
                link = channel.Links[0];
            }
            selectedProtocol = link ? link.Protocol : 'DASH';

            if (!link) return;

            currentChannel = {
                name: channel.ChannelName,
                url: link.Url,
                SigmaDrmMerchantId: link.SigmaDrmMerchantId || '',
                SigmaDrmUserId: link.SigmaDrmUserId || '',
                SigmaDrmJwt: link.SigmaDrmJwt || ''
            };

            // Save state
            localStorage.setItem('laotv_live_state', JSON.stringify({
                channelIndex: selectedChannelIndex,
                protocol: selectedProtocol
            }));
            localStorage.setItem('laotv_live_single_channel', JSON.stringify(currentChannel));

            playerTitle.textContent = channel.ChannelName;

            if (shouldPlay) {
                staticContent.style.display = 'none';
                playStream(link.Url);
            }

            renderSelectorUI();
        }

        function renderSelectorUI() {
            const container = document.getElementById('streamSelectorContainer');
            if (!container) return;
            container.innerHTML = '';

            // Channels Row (LaoTV Football & LaoTV Entertainment buttons)
            const channelsRow = document.createElement('div');
            channelsRow.className = 'selector-row';

            CHANNELS_DATA.forEach((channel, idx) => {
                const btn = document.createElement('button');
                btn.className = `stream-select-btn ${idx === selectedChannelIndex ? 'active' : ''}`;

                // Format name: LaoTV Football -> FOOTBALL TV, LaoTV Entertainment -> ENTERTAINMENT TV
                let displayName = channel.ChannelName.replace(/LaoTV\s*/i, '').toUpperCase();
                if (!displayName.endsWith('TV')) {
                    displayName += ' TV';
                }
                if (idx === 0) {
                    btn.innerHTML = `
                    <span>
                        <svg width="80" height="35" viewBox="0 0 80 35" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                        <rect width="80" height="35" rx="8" fill="url(#pattern0_5100_31907)"/>
                        <defs>
                        <pattern id="pattern0_5100_31907" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <use xlink:href="#image0_5100_31907" transform="matrix(0.000577034 0 0 0.00133162 0 -0.113008)"/>
                        </pattern>
                        <image id="image0_5100_31907" width="1733" height="980" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                        </defs>
                        </svg>
                    </span>
                `;
                } else {
                    btn.innerHTML = `
                        <span>
                            <svg width="80" height="35" viewBox="0 0 80 35" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                            <rect width="80" height="35" rx="8" fill="url(#pattern0_5100_31909)"/>
                            <defs>
                            <pattern id="pattern0_5100_31909" patternContentUnits="objectBoundingBox" width="1" height="1">
                            <use xlink:href="#image0_5100_31909" transform="matrix(0.000577367 0 0 0.00133239 0 -0.137787)"/>
                            </pattern>
                            <image id="image0_5100_31909" width="1732" height="979" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                            </defs>
                            </svg>
                        </span>
                    `;

                }
                btn.setAttribute('aria-label', displayName);
                btn.onclick = () => {
                    const shouldContinuePlaying = Boolean(loadedStreamUrl) && !video.paused;
                    selectChannel(idx, shouldContinuePlaying);
                };
                channelsRow.appendChild(btn);
            });
            container.appendChild(channelsRow);
        }

        async function initApp() {
            // 1. Fetch from CONFIG_URL first
            try {
                const res = await fetch(CONFIG_URL);
                console.log({ res })
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data) && data.length > 0) {
                        CHANNELS_DATA = data;
                    }
                }
            } catch (err) {
                console.warn('Could not load config.json, using fallback streams:', err);
            }

            // Restore the last selected channel, defaulting to the first source
            const savedState = localStorage.getItem('laotv_live_state');
            if (savedState) {
                try {
                    const parsed = JSON.parse(savedState);
                    selectedChannelIndex = parsed.channelIndex || 0;
                    selectedProtocol = parsed.protocol || 'DASH';
                } catch (e) { }
            }

            if (selectedChannelIndex >= CHANNELS_DATA.length) {
                selectedChannelIndex = 0;
            }

            setSliderFill(volumeSlider, 1, 0, 1);

            // Select the restored channel, but wait for the user to press play
            selectChannel(selectedChannelIndex, false);

            // Render the buttons
            renderSelectorUI();
        }

        // Run app initialization
        initApp();
    </script>

